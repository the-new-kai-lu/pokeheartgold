	</row>
	<row id="msg_0805_fakemon_00503" index="503">
		<attribute name="window_context_name">used</attribute>
		<language name="English"></language>
	</row>
	<row id="msg_0805_fakemon_00504" index="504">
		<attribute name="window_context_name">used</attribute>
		<language name="English"></language>
	</row>
	<row id="msg_0805_fakemon_00505" index="505">
		<attribute name="window_context_name">used</attribute>
		<language name="English"></language>
	</row>
	<row id="msg_0805_fakemon_00506" index="506">
		<attribute name="window_context_name">used</attribute>
		<language name="English"></language>
	</row>
	<row id="msg_0805_fakemon_00507" index="507">
		<attribute name="window_context_name">used</attribute>
		<language name="English"></language>
	</row>
	<row id="msg_0805_fakemon_00508" index="508">
		<attribute name="window_context_name">used</attribute>
		<language name="English"></language>
	</row>
	<row id="msg_0805_fakemon_00509" index="509">
		<attribute name="window_context_name">used</attribute>
		<language name="English"></language>
